{
  "doctype": "DocType",
  "name": "Quest AI Capability",
  "module": "Quest Automations",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "title",
      "label": "Capability name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "capability_key",
      "label": "Capability key",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "set_only_once": 1
    },
    {
      "fieldname": "description",
      "label": "What this capability does",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "enabled",
      "label": "Enabled for workflows",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "status",
      "label": "Publishing status",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "instructions",
      "label": "Instructions",
      "fieldtype": "Long Text",
      "reqd": 1
    },
    {
      "fieldname": "contracts",
      "label": "Inputs and results",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "input_schema",
      "label": "Input format",
      "fieldtype": "Code",
      "options": "JSON",
      "reqd": 1
    },
    {
      "fieldname": "output_schema",
      "label": "Output format",
      "fieldtype": "Code",
      "options": "JSON",
      "reqd": 1
    },
    {
      "fieldname": "sample_input",
      "label": "Test input",
      "fieldtype": "Code",
      "options": "JSON"
    },
    {
      "fieldname": "publication",
      "label": "Live version",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "published_revision",
      "label": "Published revision",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "last_published_at",
      "label": "Last published",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "published_definition",
      "label": "Published definition",
      "fieldtype": "Long Text",
      "read_only": 1,
      "hidden": 1
    }
  ],
  "field_order": [
    "title",
    "capability_key",
    "description",
    "enabled",
    "status",
    "instructions",
    "contracts",
    "input_schema",
    "output_schema",
    "sample_input",
    "publication",
    "published_revision",
    "last_published_at",
    "published_definition"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "autoname": "field:capability_key",
  "title_field": "title",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
